IMAGE_MODEL_ID=umm-maybe/AI-image-detector
AUDIO_MODEL_ID=mo-thecreator/Deepfake-audio-detection
DEVICE=auto
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
OLLAMA_URL=http://localhost:11434
MAX_IMAGE_MB=10
MAX_AUDIO_MB=15
RISK_LOW_MAX=35
RISK_HIGH_MIN=65
CORS_ORIGINS=http://localhost:5173

# Extras
# Load both models in the background at startup so the first request is fast.
PRELOAD_MODELS=true
# If an LLM is configured, also send the message text to it for classification.
# Set false to keep message text on this machine (the explainer never receives message text).
LLM_SEND_TEXT=true
# After the models are cached you can set HF_HUB_OFFLINE=1 to skip network checks at load time.
