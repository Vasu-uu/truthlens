{
  "manifest_version": 3,
  "name": "TruthLens",
  "version": "0.1.0",
  "description": "Right-click an image or selected text to check it for AI generation or scams with your local TruthLens backend.",
  "minimum_chrome_version": "116",
  "permissions": ["contextMenus", "sidePanel", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "panel.html" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": {
    "default_title": "TruthLens: open the results panel",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
